# Copy to .env for Nuxt dev/build. No real keys are included.
NUXT_PUBLIC_SITE_NAME="SaaS Starter"
NUXT_PUBLIC_SITE_URL=http://localhost:3000
NUXT_PUBLIC_SITE_DESCRIPTION="A simple starting point for your next product."
NUXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
NUXT_CLERK_SECRET_KEY=
NUXT_PUBLIC_CLERK_SIGN_IN_URL=/login
NUXT_PUBLIC_CLERK_SIGN_UP_URL=/login
NUXT_PUBLIC_CLERK_SIGN_IN_FALLBACK_REDIRECT_URL=/
NUXT_PUBLIC_CLERK_SIGN_UP_FALLBACK_REDIRECT_URL=/
NUXT_CREEM_PAYMENT_ENABLED=false
NUXT_PUBLIC_CREEM_PAYMENT_ENABLED=false
